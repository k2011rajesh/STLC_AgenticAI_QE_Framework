# ==============================================================================
# Agentic Playwright QE Framework - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control - it contains sensitive credentials
# ==============================================================================

# ==============================================================================
# BROWSER & UI TESTING
# ==============================================================================
UI_BASE_URL_INSURANCE=http://localhost:3000
UI_BASE_URL_HEALTHCARE=http://localhost:3001
UI_BASE_URL_BANKING=http://localhost:3002

BROWSER_TYPE=chromium
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=0
BROWSER_TIMEOUT=30000

# UI Test Credentials
UI_TEST_USER_INSURANCE=testuser@insurance.com
UI_TEST_PASSWORD_INSURANCE=TestPass123!

UI_TEST_USER_HEALTHCARE=patient@healthcare.com
UI_TEST_PASSWORD_HEALTHCARE=HealthPass123!

UI_TEST_USER_BANKING=customer@banking.com
UI_TEST_PASSWORD_BANKING=BankPass123!

# ==============================================================================
# API TESTING
# ==============================================================================
API_BASE_URL_INSURANCE=http://localhost:3000/api
API_BASE_URL_HEALTHCARE=http://localhost:3001/api
API_BASE_URL_BANKING=http://localhost:3002/api

API_TIMEOUT=15000
API_RETRY_ATTEMPTS=3

# API Authentication
API_AUTH_TYPE=Bearer
API_AUTH_TOKEN_INSURANCE=your_insurance_api_token
API_AUTH_TOKEN_HEALTHCARE=your_healthcare_api_token
API_AUTH_TOKEN_BANKING=your_banking_api_token

# API Keys (if required)
API_KEY_INSURANCE=your_insurance_api_key
API_KEY_HEALTHCARE=your_healthcare_api_key
API_KEY_BANKING=your_banking_api_key

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE_INSURANCE=insurance_test
DB_DATABASE_HEALTHCARE=healthcare_test
DB_DATABASE_BANKING=banking_test

DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT=5000

# Database SSL (for production)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ==============================================================================
# JIRA CONFIGURATION
# ==============================================================================
JIRA_BASE_URL=https://your-jira-instance.atlassian.net
JIRA_PROJECT_KEY=AUTO
JIRA_API_USERNAME=your_jira_email@company.com
JIRA_API_TOKEN=your_jira_api_token

# Xray Configuration
JIRA_XRAY_ENABLED=true
XRAY_API_URL=https://api.atlassian.net/site/your-site-id/xray
XRAY_CLIENT_ID=your_xray_client_id
XRAY_CLIENT_SECRET=your_xray_client_secret

# Test Execution Mapping
XRAY_TEST_PLAN_KEY_INSURANCE=AUTO-TP-001
XRAY_TEST_PLAN_KEY_HEALTHCARE=AUTO-TP-002
XRAY_TEST_PLAN_KEY_BANKING=AUTO-TP-003

# ==============================================================================
# GITHUB CONFIGURATION
# ==============================================================================
GITHUB_REPO_OWNER=your-org
GITHUB_REPO_NAME=playwright-agentic-qe-framework
GITHUB_TOKEN=your_github_token
GITHUB_BRANCH=main

# GitHub Actions
GITHUB_ACTIONS_ENABLED=true
GITHUB_WORKFLOW_FILE=.github/workflows/ci-cd.yml

# ==============================================================================
# CI/CD PIPELINE
# ==============================================================================
CICD_ENVIRONMENT=staging
CICD_DEPLOYMENT_URL=https://staging.example.com

# Pipeline Configuration
RUN_SMOKE_TESTS=true
RUN_REGRESSION_TESTS=true
RUN_API_TESTS=true
RUN_DB_TESTS=true

# Quality Gates
MIN_PASS_RATE=90
MIN_COVERAGE_PERCENT=80
FAIL_ON_FLAKY=true

# ==============================================================================
# OPENAI CONFIGURATION (AI Agents)
# ==============================================================================
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Agent Configuration
USE_AI_AGENTS=true
AGENT_TIMEOUT=30000

# ==============================================================================
# TEST EXECUTION CONFIGURATION
# ==============================================================================
TEST_ENVIRONMENT=local
TEST_DATA_RESET=true
TEST_PARALLEL_EXECUTION=false
TEST_PARALLEL_WORKERS=3

# Timeouts
ELEMENT_WAIT_TIMEOUT=10000
PAGE_LOAD_TIMEOUT=30000
NETWORK_TIMEOUT=15000

# Retry Configuration
RETRY_FAILED_TESTS=true
RETRY_ATTEMPTS=2
RETRY_DELAY=1000

# ==============================================================================
# REPORTING & LOGGING
# ==============================================================================
REPORT_FORMAT=html,json
REPORT_OUTPUT_DIR=reports
LOG_LEVEL=info
CAPTURE_SCREENSHOTS=true
CAPTURE_VIDEOS=false

# ==============================================================================
# TEST DATA MANAGEMENT
# ==============================================================================
TEST_DATA_SOURCE=local
TEST_DATA_RESET_BEFORE_SUITE=true
TEST_DATA_CLEANUP_AFTER_SUITE=true

# Test Data Paths
TEST_DATA_DIR=playwright/fixtures
INSURANCE_TEST_DATA=playwright/fixtures/insuranceData.js
HEALTHCARE_TEST_DATA=playwright/fixtures/healthcareData.js
BANKING_TEST_DATA=playwright/fixtures/bankingData.js

# Mock Data Generation
ENABLE_MOCK_DATA_GENERATION=true
MOCK_DATA_SEED=12345

# ==============================================================================
# COMPLIANCE & SECURITY
# ==============================================================================
ENABLE_HIPAA_CHECKS=true
ENABLE_GDPR_CHECKS=true
ENABLE_DODD_FRANK_CHECKS=true
ENABLE_SOX_CHECKS=true
ENABLE_PCI_DSS_CHECKS=true

# Data Encryption
ENCRYPT_SENSITIVE_DATA=true
ENCRYPTION_ALGORITHM=aes-256-cbc
ENCRYPTION_KEY=your_encryption_key_32_chars_long_

# ==============================================================================
# NOTIFICATIONS & WEBHOOKS
# ==============================================================================
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

EMAIL_ENABLED=false
EMAIL_FROM=automation@company.com
EMAIL_TO=qa-team@company.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# ==============================================================================
# DEBUGGING & DEVELOPMENT
# ==============================================================================
DEBUG_MODE=false
VERBOSE_LOGGING=false
SAVE_DEBUG_ARTIFACTS=true
DEBUG_BREAKPOINT_ENABLED=false

# ==============================================================================
# VERSION & METADATA
# ==============================================================================
FRAMEWORK_VERSION=1.0.0
BUILD_NUMBER=${CI_BUILD_NUMBER:-local}
BUILD_TIMESTAMP=${BUILD_TIMESTAMP:-$(date)}
